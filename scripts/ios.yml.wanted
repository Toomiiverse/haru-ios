# The workflow as it should be once the App Store Connect secrets exist. The
# server's gh token cannot push .github/workflows/, so this is applied by hand:
#   cp scripts/ios.yml.wanted .github/workflows/ios.yml   (from a machine whose
#   git can push workflow files), or paste it in on GitHub.
name: iOS
on:
  push:
    branches: [main]
  workflow_dispatch:
jobs:
  build:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v4
      - name: Build (signed and uploaded to TestFlight when the secrets are set; unsigned otherwise)
        env:
          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
          ASC_KEY_P8: ${{ secrets.ASC_KEY_P8 }}
          APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
        run: bash scripts/build-ipa.sh
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: Haru-unsigned-ipa
          path: Haru-unsigned.ipa
          if-no-files-found: ignore
