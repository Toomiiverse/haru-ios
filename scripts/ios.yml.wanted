# The workflow as it should be once the App Store Connect secrets exist. The
# server's gh token cannot push .github/workflows/, so this is applied by hand:
#   cp scripts/ios.yml.wanted .github/workflows/ios.yml   (from a machine whose
#   git can push workflow files), or paste it in on GitHub.
name: iOS
on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      upload_to_testflight:
        description: Upload after the CarPlay entitlement is approved for this App ID
        type: boolean
        default: false
jobs:
  build:
    runs-on: xcode-27
    steps:
      - uses: actions/checkout@v4
      - name: Build (signed and uploaded to TestFlight when the secrets are set; unsigned otherwise)
        env:
          ASC_KEY_ID: ${{ (github.event_name == 'push' || inputs.upload_to_testflight) && secrets.ASC_KEY_ID || '' }}
          ASC_ISSUER_ID: ${{ (github.event_name == 'push' || inputs.upload_to_testflight) && secrets.ASC_ISSUER_ID || '' }}
          ASC_KEY_P8: ${{ (github.event_name == 'push' || inputs.upload_to_testflight) && secrets.ASC_KEY_P8 || '' }}
          APPLE_TEAM_ID: ${{ (github.event_name == 'push' || inputs.upload_to_testflight) && secrets.APPLE_TEAM_ID || '' }}
        run: bash scripts/build-ipa.sh
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: Haru-unsigned-ipa
          path: Haru-unsigned.ipa
          if-no-files-found: ignore
